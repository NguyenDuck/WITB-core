{
	"inv_slot": {
		"type": "panel",
		"collection_index": "$slot_index",
		"bindings": [
			{
				"binding_name": "#hud_title_text_string",
				"binding_name_override": "#text"
			},
			{
				"binding_name": "#hud_title_text_string",
				"binding_name_override": "#text2",
				"binding_condition": "visibility_changed"
			},
			{
				"binding_type": "view",
				"source_property_name": "(not (#text - $item_changed_const = #text) and not (#text = #text2))",
				"target_property_name": "#visible"
			},
			{
				"binding_name": "#item_id_aux",
				"binding_type": "collection",
				"binding_collection_name": "hotbar_items",
				"binding_condition": "visibility_changed"
			}
		]
	},
	"witb": {
		"type": "panel",
		"size": ["100%cm", "100%c"],
		"controls": [
			{
				"main_container": {
					"type": "panel",
					"size": ["100%c", "100%cm"],
					"anchor_from": "top_left",
					"anchor_to": "top_left",
					"controls": [
						{
							"renderer_container": {
								"type": "panel",
								"size": ["100%cm + 4px", "100%cm + 3px"],
								"offset": [4, 3],
								"anchor_from": "top_left",
								"anchor_to": "top_left",
								"controls": [
									{
										"item_renderer": {
											"type": "custom",
											"renderer": "inventory_item_renderer",
											"size": [20, 20],
											"offset": [0, 1],
											"anchor_from": "top_left",
											"anchor_to": "top_left",
											"controls": [
												{
													"stack": {
														"type": "stack_panel",
														"size": "$zero_size",
														"collection_name": "hotbar_items",
														"controls": [
															{
																"collection_name@hud.inv_slot": {}
															}
														],
														"bindings": [
															{
																"binding_type": "view",
																"source_control_name": "collection_name",
																"resolve_sibling_scope": true,
																"source_property_name": "#item_id_aux",
																"target_property_name": "#item_id_aux"
															}
														]
													}
												}
											],
											"bindings": [
												{
													"binding_type": "view",
													"source_control_name": "stack",
													"resolve_sibling_scope": true,
													"source_property_name": "#item_id_aux",
													"target_property_name": "#item_id_aux"
												}
											]
										}
									}
								],
								"bindings": [
									{
										"binding_type": "view",
										"source_control_name": "get_title",
										"source_property_name": "(#text - $entity_changed_const = #text)",
										"target_property_name": "#visible"
									}
								]
							}
						},
						{
							"name_container": {
								"type": "panel",
								"size": ["100%cm + 8px", "100%c"],
								"anchor_from": "top_right",
								"anchor_to": "top_right",
								"controls": [
									{
										"block_name_container": {
											"type": "panel",
											"size": ["100%cm + 2px", "100%cm + 4px"],
											"$offset": [5, 4],
											"anchor_from": "top_left",
											"anchor_to": "top_left",
											"controls": [
												{
													"block_name": {
														"type": "label",
														"font_scale_factor": "$font_scale",
														"text": "#text",
														"localize": true,
														"offset": "$offset",
														"anchor_from": "top_left",
														"anchor_to": "top_left",
														"controls": [
															{
																"get_name": {
																	"type": "label",
																	"bindings": [
																		{
																			"binding_name": "#hud_title_text_string",
																			"binding_name_override": "#text"
																		},
																		{
																			"binding_name": "#hud_title_text_string",
																			"binding_name_override": "#text2",
																			"binding_condition": "visibility_changed"
																		},
																		{
																			"binding_type": "view",
																			"source_property_name": "((not (#text - $item_changed_const = #text) or not (#text - $entity_changed_const = #text)) and not (#text = #text2))",
																			"target_property_name": "#visible"
																		}
																	]
																}
															}
														],
														"bindings": [
															{
																"binding_type": "view",
																"source_control_name": "get_name",
																"source_property_name": "(#text2 - $item_changed_const - $entity_changed_const)",
																"target_property_name": "#text"
															}
														]
													}
												}
											]
										}
									},
									{
										"block_namespace_container": {
											"type": "panel",
											"size": ["100%cm + 2px", "100%cm + 4px"],
											"$offset": [5, 14],
											"anchor_from": "top_left",
											"anchor_to": "top_left",
											"controls": [
												{
													"block_namespace": {
														"type": "label",
														"font_scale_factor": "$font_scale",
														"text": "#text",
														"localize": true,
														"offset": "$offset",
														"anchor_from": "top_left",
														"anchor_to": "top_left",
														"controls": [
															{
																"get_namespace": {
																	"type": "label",
																	"bindings": [
																		{
																			"binding_name": "#hud_subtitle_text_string",
																			"binding_name_override": "#text"
																		},
																		{
																			"binding_name": "#hud_subtitle_text_string",
																			"binding_name_override": "#text2",
																			"binding_condition": "visibility_changed"
																		},
																		{
																			"binding_type": "view",
																			"source_property_name": "(not (#text - $namespace_const = #text) and not (#text = #text2))",
																			"target_property_name": "#visible"
																		}
																	]
																}
															}
														],
														"bindings": [
															{
																"binding_type": "view",
																"source_control_name": "get_namespace",
																"source_property_name": "('§o§9' + (#text2 - $namespace_const))",
																"target_property_name": "#text"
															}
														]
													}
												}
											]
										}
									}
								]
							}
						}
					]
				}
			},
			{
				"block_desc_container": {
					"type": "stack_panel",
					"size": ["100%c + 12px", "100%cm + 3px"],
					"offset": [6, 26],
					"anchor_from": "top_left",
					"anchor_to": "top_left",
					"controls": [
						{
							"block_desc": {
								"type": "label",
								"font_scale_factor": "$font_scale",
								"text": "#text",
								"controls": [
									{
										"get_desc": {
											"type": "label",
											"bindings": [
												{
													"binding_name": "#hud_subtitle_text_string",
													"binding_name_override": "#text"
												},
												{
													"binding_name": "#hud_subtitle_text_string",
													"binding_name_override": "#text2",
													"binding_condition": "visibility_changed"
												},
												{
													"binding_type": "view",
													"source_property_name": "(not (#text - $description_const = #text) and not (#text = #text2))",
													"target_property_name": "#visible"
												}
											]
										}
									}
								],
								"bindings": [
									{
										"binding_type": "view",
										"source_control_name": "get_desc",
										"source_property_name": "(#text2 - $description_const)",
										"target_property_name": "#text"
									}
								]
							}
						}
					],
					"bindings": [
						{
							"binding_type": "view",
							"source_control_name": "get_subtitle",
							"source_property_name": "((#text - $namespace_const) = #text)",
							"target_property_name": "#visible"
						}
					]
				}
			}
		]
	},
	"outline": {
		"$color": [0.75, 0.75, 0.75],
		"type": "custom",
		"renderer": "gradient_renderer",
		"color1": "$color",
		"color2": "$color",
		"alpha": 0.4,
		"size": ["100%cm + 2px", "100%cm + 2px"],
		"controls": [
			{
				"background": {
					"$color": [0.005, 0.005, 0.025],
					"type": "custom",
					"renderer": "gradient_renderer",
					"color1": "$color",
					"color2": "$color",
					"alpha": 0.6,
					"size": "$max_child_size",
					"controls": [
						{
							"witb@hud.witb": {}
						}
					]
				}
			}
		]
	},
	"root_panel": {
		"modifications": [
			{
				"array_name": "controls",
				"operation": "insert_front",
				"value": [
					{
						"witb@hud.outline": {
							"offset": [0, 20],
							"anchor_from": "$position",
							"anchor_to": "$position",
							"bindings": [
								{
									"binding_type": "view",
									"source_control_name": "get_title",
									"source_property_name": "((#text - $view_disabled) = #text)",
									"target_property_name": "#visible"
								}
							]
						}
					},
					{
						"get_title": {
							"type": "label",
							"size": "$zero_size",
							"anchor_from": "bottom_left",
							"anchor_to": "bottom_left",
							"text": "#text",
							"controls": [
								{
									"_title": {
										"type": "label",
										"size": "$zero_size",
										"bindings": [
											{
												"binding_name": "#hud_title_text_string",
												"binding_name_override": "#text"
											},
											{
												"binding_name": "#hud_title_text_string",
												"binding_name_override": "#text2",
												"binding_condition": "visibility_changed"
											},
											{
												"binding_type": "view",
												"source_property_name": "(not (#text - $prefix = #text) and not (#text = #text2))",
												"target_property_name": "#visible"
											}
										]
									}
								}
							],
							"bindings": [
								{
									"binding_type": "view",
									"source_control_name": "_title",
									"resolve_sibling_scope": true,
									"source_property_name": "#text2",
									"target_property_name": "#text"
								}
							]
						}
					},
					{
						"get_subtitle": {
							"type": "label",
							"size": "$zero_size",
							"anchor_from": "bottom_left",
							"anchor_to": "bottom_left",
							"text": "#text",
							"controls": [
								{
									"_subtitle": {
										"type": "label",
										"size": "$zero_size",
										"bindings": [
											{
												"binding_name": "#hud_subtitle_text_string",
												"binding_name_override": "#text"
											},
											{
												"binding_name": "#hud_subtitle_text_string",
												"binding_name_override": "#text2",
												"binding_condition": "visibility_changed"
											},
											{
												"binding_type": "view",
												"source_property_name": "(not (#text - $prefix = #text) and not (#text = #text2))",
												"target_property_name": "#visible"
											}
										]
									}
								}
							],
							"bindings": [
								{
									"binding_type": "view",
									"source_control_name": "_subtitle",
									"resolve_sibling_scope": true,
									"source_property_name": "#text2",
									"target_property_name": "#text"
								}
							]
						}
					}
				]
			}
		]
	}
}
