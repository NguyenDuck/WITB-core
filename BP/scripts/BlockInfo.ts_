import {
	Block,
	BlockPermutation,
	BlockType,
	ItemLockMode,
	Player,
	Vector3,
	system,
} from '@minecraft/server'
import BlockTranslator from './translator/block/BlockTranslator'
import BlockBase from './BlockBase'
import { BlockTransEntry, RequestPermission, StateHandler, TransKey } from './types'
import BlockNameDisplayer from './BlockNameDisplayer'
import BlockDescDisplayer from './BlockDescDisplayer'
import { isPermutationEquals, toBlockStateMap } from './utils'
import Settings from './Settings'

const addLine = (a: string[]) => a.push('\n')
const pushText = (a: string[], s: string) => a.push(s)

export default class BlockInfo {
	private block: BlockBase
	private transKey: TransKey
	private lastBlock: {
		type?: BlockType
		location?: Vector3
		permutation?: BlockPermutation
	}
	private lastTranslatorKey: string
	private lastTranslatorVal?: BlockTransEntry

	private readonly displayer: {
		name: BlockNameDisplayer
		desc: BlockDescDisplayer
	}

	constructor(private player: Player) {
		this.displayer = {
			name: new BlockNameDisplayer(player),
			desc: new BlockDescDisplayer(player),
		}
		this.lastBlock = {}
		this.displayN.removeName()
	}

	send(block?: Block) {
		if (!block) return this.handleNonBlock()

		this.block = new BlockBase(block)

		if (Settings.debugMode) this.logCurrentBlock()

		this.transKey = new TransKey(this.block.isVanilla() ? this.block.name : this.block.typeId)

		this.displayN.namespace = this.block.namespace

		const translator = this.getTranslator()

		if (translator) this.handleTranslator(translator)
		else {
			this.displayN.name = this.transKey

			if (this.displayN.isChanged) {
				let old_item = this.displayN.playerItem
				const new_item = this.block.itemStack

				new_item.lockMode = ItemLockMode.slot
				new_item.setLore(['witb locked'])
				system.runTimeout(() => this.displayN.send(), 0)

				this.displayN.playerItem = new_item

				if (!this.displayD.isEmpty())
					system.runTimeout(() => this.displayD.removeDescription(), 1)

				system.runTimeout(() => (this.displayN.playerItem = old_item), 2)
			}

			if (this.displayD.isChanged) {
				system.runTimeout(() => this.displayD.send(), 1)
			}
		}

		this.lastBlock = {
			type: this.block.type,
			location: this.block.location,
			permutation: this.block.permutation,
		}
	}

	private logCurrentBlock() {
		const text = ['§a', this.block.typeId]

		let states = this.block.permutation.getAllStates()

		if (Object.getOwnPropertyNames(states)) {
			pushText(
				text,
				`§6${JSON.stringify(
					states,
					(_, v) => {
						let i = ['string', 'number', 'boolean'].indexOf(typeof v)
						return i === -1 ? v : `§${['g', 'b', 'd'][i]}${v}§6`
					},
					'*'
				)}`
					.replace(/"|,|\*/g, '')
					.replace(/(^\{\n|\{|\}|\}\n$)/g, '')
			)
		}

		addLine(text)
		pushText(text, `§cTranslator: §9${this.lastTranslatorKey}`)

		this.player.onScreenDisplay.setActionBar(text.join(''))
	}

	private handleNonBlock() {
		if (this.lastBlock.type) {
			this.lastBlock = {}
			this.lastTranslatorVal = undefined
			this.displayN.removeName()
			this.displayD.description = ''
		}
	}

	private handleTranslator(trans: BlockTransEntry) {
		if (trans.Type) {
			this.transKey.type = trans.Type
		}
		if (trans.Override) this.transKey.name = trans.Override

		if (trans.StateHandler) {
			this.handleState(trans.StateHandler, trans.RequestPermission)
		} else {
			this.displayN.name = this.transKey
			if (this.displayN.isChanged) {
				let old_item = this.displayN.playerItem
				const new_item = this.block.itemStack
				new_item.lockMode = ItemLockMode.slot
				new_item.setLore(['witb locked'])
				system.runTimeout(() => this.displayN.send(), 0)
				this.displayN.playerItem = new_item
				if (!this.displayD.isEmpty())
					system.runTimeout(() => this.displayD.removeDescription(), 1)
				system.runTimeout(() => (this.displayN.playerItem = old_item), 2)
			}

			if (this.displayD.isChanged) {
				system.runTimeout(() => this.displayD.send(), 1)
			}
		}
	}

	private handleState(callback: StateHandler<any>, additionalPermissions?: RequestPermission[]) {
		const perm = this.block.permutation

		if (this.lastBlock.permutation && isPermutationEquals(this.lastBlock.permutation, perm))
			return

		const states = toBlockStateMap(perm)
		let param = new Map()

		if (additionalPermissions) {
			additionalPermissions.forEach(v => {
				switch (v) {
					case 'getRedstonePower':
						return param.set(v, () => this.block.getRedstonePower())
				}
			})
		}

		const [name, desc] = callback({ lang: this.transKey, states, param })

		if (name) this.transKey.name = name.toString()

		if (desc) {
			this.displayD.description = desc
		} else {
			this.displayD.removeDescription()
		}

		this.displayN.name = this.transKey

		if (this.displayN.isChanged) {
			let old_item = this.displayN.playerItem
			const new_item = this.block.itemStack
			new_item.lockMode = ItemLockMode.slot
			new_item.setLore(['witb locked'])
			system.runTimeout(() => this.displayN.send(), 0)
			this.displayN.playerItem = new_item
			system.runTimeout(() => (this.displayN.playerItem = old_item), 2)
		}

		if (this.displayD.isChanged) {
			system.runTimeout(() => this.displayD.send(), 1)
		}
	}

	private getTranslator() {
		const lang = this.block.name

		this.lastTranslatorKey = lang
		let trans = BlockTranslator[lang]

		if (trans && trans.Ref) {
			this.lastTranslatorKey = trans.Ref
			trans = BlockTranslator[trans.Ref]
		}

		if (!trans) {
			for (const key in BlockTranslator) {
				let pattern = key.replace('*', '[a-z]+')
				if (pattern === key) continue

				pattern = `(${pattern})`

				if (lang.match(pattern)) {
					this.lastTranslatorKey = key
					trans = BlockTranslator[key]

					if (trans && trans.Ref) {
						this.lastTranslatorKey = trans.Ref
						trans = BlockTranslator[trans.Ref]
					}
					break
				}
			}
		}

		this.lastTranslatorVal = trans
		return this.lastTranslatorVal
	}

	private get displayN() {
		return this.displayer.name
	}

	private get displayD() {
		return this.displayer.desc
	}
}
