{
	"$schema": "https://raw.githubusercontent.com/Bedrock-OSS/regolith-schemas/main/config/v1.2.json",
	"author": "NguyenDuck",
	"name": "WITB",
	"packs": {
		"behaviorPack": "./BP",
		"resourcePack": "./RP"
	},
	"regolith": {
		"dataPath": "./data",
		"filterDefinitions": {
			"esbuild_executor": {
				"url": "github.com/MajestikButter/Regolith-Filters",
				"version": "6fa6a6a9298f7d033d0f2e421edfb33292807aae"
			},
			"minimize": {
				"url": "github.com/cda94581/regolith-filters",
				"version": "0.0.4"
			},
			"UI_builder": {
				"runWith": "shell",
				"command": "cd data/ui; bun run main.ts"
			},
			"UI": {
				"runWith": "nodejs",
				"script": "data/filters/UI-Copy/main.js"
			}
		},
		"profiles": {
			"default": {
				"export": {
					"readOnly": false,
					"target": "development"
				},
				"filters": [
					{
						"filter": "minimize"
					},
					{
						"filter": "esbuild_executor",
						"settings": {
							"buildOptions": {
								"bundle": true,
								"entryPoints": ["data/scripts/main.ts"],
								"outfile": "BP/scripts/main.js",
								"external": ["@minecraft/server", "@minecraft/server-ui", "@minecraft/server-gametest"],
								"mainFields": ["main", "module"],
								"tsconfig": "../../tsconfig.json",
								"minify": false,
								"sourcemap": "linked",
								"platform": "neutral"
							}
						}
					}
				]
			},
			"preview": {
				"export": {
					"readOnly": false,
					"target": "preview"
				},
				"filters": [
					{
						"filter": "minimize"
					},
					{
						"filter": "esbuild_executor",
						"settings": {
							"buildOptions": {
								"bundle": true,
								"entryPoints": ["data/scripts/main.ts"],
								"external": ["@minecraft/server", "@minecraft/server-ui", "@minecraft/server-gametest"],
								"mainFields": ["main", "module"],
								"minify": false,
								"outfile": "BP/scripts/main.js",
								"platform": "neutral"
							}
						}
					},
					{
						"filter": "UI_builder"
					},
					{
						"filter": "UI"
					}
				]
			},
			"export": {
				"export": {
					"readOnly": false,
					"target": "development"
				},
				"filters": [
					{
						"filter": "minimize"
					},
					{
						"filter": "esbuild_executor",
						"settings": {
							"buildOptions": {
								"bundle": true,
								"entryPoints": ["data/scripts/main.ts"],
								"external": ["@minecraft/server", "@minecraft/server-ui", "@minecraft/server-gametest"],
								"mainFields": ["main", "module"],
								"minify": true,
								"outfile": "BP/scripts/main.js",
								"platform": "neutral"
							}
						}
					}
				]
			}
		}
	}
}
